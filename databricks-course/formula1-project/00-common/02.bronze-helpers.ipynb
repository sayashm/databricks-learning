    "def add_ingetion_metadata(df):\n",
    "    return(\n",
    "        df\n",
    "        .withColumn('ingestion_timestamp', F.current_timestamp())\n",
    "        .withColumn('source_file', F.col('_metadata.file_path'))\n",
    "    )"
